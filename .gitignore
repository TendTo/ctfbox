__pycache__/
/config.json
/config.simulation.json
volumes/**
volumes/
/compose.yml
/.ctfbox-compose.yml
/.ctfbox-compose*.yml
/.ctfbox-sim-compose*.yml
/.ctfbox-sim-teams.yml
/.ctfbox-secrets-tmp
/.ctfbox-secrets-tmp/** */
/.deploy_info
incus/data/**
incus/data
/simulation/checkers/checklib.py
/simulation/checkers/requirements.txt
/simulation/checkers/*/flag_ids/

# Output of ./demo/build.py: the assembled public site.
_site/

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ansible inventory
inventory.yml
/ansible/inventory.yml
/ansible/*.pem
